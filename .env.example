# ============================================================
# BOT_CHAMADOS - Exemplo de configuracao
# ============================================================
# Copie este arquivo para ".env" e preencha com os valores reais:
#     cp .env.example .env
#
# O arquivo ".env" NUNCA deve ser enviado ao GitHub (ja esta no .gitignore).
# Todos os IDs abaixo sao numericos (snowflakes do Discord).
# Para obter um ID no Discord: ative o "Modo desenvolvedor" e clique com o
# botao direito no servidor/canal/cargo/mensagem -> "Copiar ID".
# ============================================================

# --- Discord -------------------------------------------------
DISCORD_TOKEN=cole_aqui_o_token_do_bot
GUILD_ID=000000000000000000

# Canais e cargos da operacao
CHANNEL_PANEL_ID=000000000000000000
CHANNEL_LOGS_ID=000000000000000000
CHANNEL_QUEUE_ID=000000000000000000
CHANNEL_DASHBOARD_ID=000000000000000000
ROLE_SUPPORT_ID=000000000000000000
ROLE_ADMIN_ID=000000000000000000

# Opcionais (se vazio, herdam CHANNEL_QUEUE_ID / CHANNEL_PANEL_ID)
CHANNEL_TICKETS_ID=
CHANNEL_THREADS_ID=

# Categorias (opcional; usadas apenas para o modo "canal" sem threads)
CATEGORY_OPEN_ID=0
CATEGORY_CLOSED_ID=0

# --- E-mail (SMTP) -------------------------------------------
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@exemplo.com
SMTP_PASS=senha_ou_senha_de_app
EMAIL_FROM=usuario@exemplo.com
EMAIL_TO=destino@exemplo.com
# auto | ssl | starttls
SMTP_SSL_MODE=auto

# --- Armazenamento (opcional) --------------------------------
# Caminhos dos dados. Padroes mostrados abaixo.
DATA_FILE=ticket_data.json
ATTACHMENTS_DIR=ticket_email_attachments
# Limite por anexo, em bytes (padrao: 25 MB)
MAX_ATTACHMENT_BYTES=26214400
